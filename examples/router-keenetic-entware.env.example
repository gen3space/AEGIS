# ==============================================================================
# Example 2: Keenetic (Entware SSH on Port 222) or Asuswrt-Merlin (`br0`)
# Note: Keenetic Entware OpenSSH/Dropbear typically listens on port 222 and
#       uses `br0` as the main Home LAN bridge.
# Usage: cp examples/router-keenetic-entware.env.example .env && aegis --open-browser
# ==============================================================================
AEGIS_MODE=router
AEGIS_ROUTER_HOST=192.168.1.1
AEGIS_ROUTER_PORT=222
AEGIS_ROUTER_USER=root
AEGIS_ROUTER_IFACE=br0
AEGIS_SSH_KEY=~/.ssh/id_ed25519
