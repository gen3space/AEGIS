# ==============================================================================
# Example 3: Linux / Raspberry Pi / Debian / Ubuntu Gateway or Ubiquiti EdgeOS
# Tip: Ensure your SSH user has `CAP_NET_RAW` on `/usr/bin/tcpdump` or root key.
# Usage: cp examples/router-linux-gateway.env.example .env && aegis --open-browser
# ==============================================================================
AEGIS_MODE=router
AEGIS_ROUTER_HOST=10.0.0.1
AEGIS_ROUTER_PORT=22
AEGIS_ROUTER_USER=root
AEGIS_ROUTER_IFACE=eth0
AEGIS_SSH_KEY=~/.ssh/id_ed25519
