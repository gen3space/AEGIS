# ==============================================================================
# Example 1: OpenWrt 23.05 / 24.10 / 25.x or GL.iNet Router (Flint 2, Beryl AX)
# Usage: cp examples/router-openwrt.env.example .env && aegis --open-browser
# ==============================================================================
AEGIS_MODE=router
AEGIS_ROUTER_HOST=192.168.1.1
AEGIS_ROUTER_PORT=22
AEGIS_ROUTER_USER=root
AEGIS_ROUTER_IFACE=br-lan
AEGIS_SSH_KEY=~/.ssh/id_ed25519
AEGIS_SSH_STRICT_HOST_KEY=accept-new
